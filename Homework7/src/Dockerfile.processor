# Build stage
FROM golang:1.21-alpine AS builder

WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the order processor binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o orderProcessor orderProcessor.go

# Runtime stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /root/

# Copy the binary from builder
COPY --from=builder /app/orderProcessor .

# Expose health check port (optional, for future health checks)
EXPOSE 8081

# Run the order processor
CMD ["./orderProcessor"]
